{
    "authors": [
        {
            "name": "Philip Schlender"
        }
    ],
    "autoload": {
        "psr-4": {
            "Fs\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": {
            "*": "dist"
        },
        "sort-packages": true
    },
    "description": "Fs",
    "license": "MIT",
    "minimum-stability": "stable",
    "name": "philipschlender/fs-php",
    "prefer-stable": true,
    "require": {
        "php": ">=8.4",
        "ext-fileinfo": "*",
        "philipschlender/io-php": "^1.2"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.92",
        "philipschlender/faker-php": "^3.2",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^12.5"
    },
    "scripts": {
        "php-cs-fixer": [
            "./vendor/bin/php-cs-fixer fix"
        ],
        "phpstan": [
            "./vendor/bin/phpstan --memory-limit=256M"
        ],
        "phpunit": [
            "./vendor/bin/phpunit"
        ],
        "phpunit-coverage": [
            "./vendor/bin/phpunit --coverage-text"
        ],
        "phpunit-coverage-html": [
            "./vendor/bin/phpunit --coverage-html coverage"
        ],
        "qa": [
            "@php-cs-fixer",
            "@phpstan",
            "@phpunit"
        ]
    },
    "type": "library"
}
